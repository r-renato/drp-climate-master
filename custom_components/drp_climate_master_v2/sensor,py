"""Support for Thermostats."""
from __future__ import annotations

import logging
from collections import deque
from decimal import Decimal
from statistics import fmean
from typing import Any, Mapping, Deque, Optional

from homeassistant.core import HomeAssistant, callback, State
from homeassistant.const import PERCENTAGE, UnitOfTemperature
from homeassistant.components.sensor import (
    RestoreSensor,
    SensorEntity,
    SensorDeviceClass,
    SensorStateClass,
)
from homeassistant.helpers.update_coordinator import (
    CoordinatorEntity,
    DataUpdateCoordinator,
)

from .controller import Controller
from .utils.const import (
    CONF_AREA,
    CONF_HUMIDITY,
    CONF_TEMPERATURE,
    DWP_NAME_POSTFIX,
    H_NAME_POSTFIX,
    HNX_NAME_POSTFIX,
    MAX_CH_NAME_POSTFIX,
    MAX_CT_NAME_POSTFIX,
    MIN_CH_NAME_POSTFIX,
    MIN_CT_NAME_POSTFIX,
    NAME,
    SCAN_INTERVAL,
    T_NAME_POSTFIX,
    ClimateSensorType,
)
from .utils.helpers import convert_to_float
from .utils.psychrometric import dew_point, dew_point_perception, heat_index

_LOGGER = logging.getLogger(__name__)


def _slugify_name(name: str) -> str:
    return "sensor." + (name or "").lower().replace(" ", "_").replace("-", "_")


class ClimateSensor(
    CoordinatorEntity[DataUpdateCoordinator[Optional[Mapping[str, Any]]]],
    RestoreSensor,
    SensorEntity,
):
    """Climate register sensor."""

    _attr_should_poll = False
    _attr_state_class = SensorStateClass.MEASUREMENT

    def __init__(
        self,
        hass: HomeAssistant,
        hub: Controller,
        coordinator: DataUpdateCoordinator[Optional[Mapping[str, Any]]],
        idx: int,
        config: dict[str, Any],
        area_entry: dict[str, Any],
        unit: str,
        climate_sensor: str,
    ) -> None:
        super().__init__(coordinator)
        self._hass = hass
        self._hub = hub
        self._idx = idx
        self._config = config
        self._area_config = area_entry
        self._climate_sensor = climate_sensor

        # -------- Device / Entity identity
        if climate_sensor == ClimateSensorType.DEW_POINT:
            postfix = DWP_NAME_POSTFIX
            self._attr_device_class = SensorDeviceClass.TEMPERATURE
            self._attr_native_unit_of_measurement = unit or UnitOfTemperature.CELSIUS
        elif climate_sensor == ClimateSensorType.HEAT_INDEX:
            postfix = HNX_NAME_POSTFIX
            self._attr_device_class = SensorDeviceClass.TEMPERATURE
            self._attr_native_unit_of_measurement = unit or UnitOfTemperature.CELSIUS
        elif climate_sensor == ClimateSensorType.CURRENT_TEMPERATURE:
            postfix = T_NAME_POSTFIX
            self._attr_device_class = SensorDeviceClass.TEMPERATURE
            self._attr_native_unit_of_measurement = unit or UnitOfTemperature.CELSIUS
        elif climate_sensor == ClimateSensorType.CURRENT_HUMIDITY:
            postfix = H_NAME_POSTFIX
            self._attr_device_class = SensorDeviceClass.HUMIDITY
            self._attr_native_unit_of_measurement = PERCENTAGE
        elif climate_sensor == ClimateSensorType.MAX_CONFORT_TEMPERATURE:
            postfix = MAX_CT_NAME_POSTFIX
            self._attr_device_class = SensorDeviceClass.TEMPERATURE
            self._attr_native_unit_of_measurement = unit or UnitOfTemperature.CELSIUS
        elif climate_sensor == ClimateSensorType.MIN_CONFORT_TEMPERATURE:
            postfix = MIN_CT_NAME_POSTFIX
            self._attr_device_class = SensorDeviceClass.TEMPERATURE
            self._attr_native_unit_of_measurement = unit or UnitOfTemperature.CELSIUS
        elif climate_sensor == ClimateSensorType.MAX_CONFORT_HUMIDITY:
            postfix = MAX_CH_NAME_POSTFIX
            self._attr_device_class = SensorDeviceClass.HUMIDITY
            self._attr_native_unit_of_measurement = PERCENTAGE
        elif climate_sensor == ClimateSensorType.MIN_CONFORT_HUMIDITY:
            postfix = MIN_CH_NAME_POSTFIX
            self._attr_device_class = SensorDeviceClass.HUMIDITY
            self._attr_native_unit_of_measurement = PERCENTAGE
        else:
            postfix = "na"

        area_name = area_entry[CONF_AREA]
        self._attr_name = f"Ambient {area_name} {postfix}"
        self._attr_unique_id = f"ambient_{area_name}_{idx}_{postfix}"

        # -------- Rolling window (no pandas)
        # SCAN_INTERVAL: timedelta -> finest window of ~3h
        self._window_size: int = max(1, (3 * 60 * 60) // SCAN_INTERVAL.seconds)
        self._samples: Deque[float] = deque(maxlen=self._window_size)

        # Runtime
        self._attr_native_value: Optional[float] = None
        self._temperature_entity_id: Optional[str] = None
        self._humidity_entity_id: Optional[str] = None

        _LOGGER.debug(
            "Initialized %s (%s) window=%s",
            self._attr_name,
            self.entity_id or _slugify_name(self._attr_name),
            self._window_size,
        )

    @property
    def device_info(self) -> dict[str, Any] | None:
        # Collega tutte le entità del clima a un singolo "device" logico
        return {
            "identifiers": {(NAME, f"ambient_{self._area_config[CONF_AREA]}")},
            "manufacturer": NAME,
            "name": f"Ambient {self._area_config[CONF_AREA]}",
        }

    async def async_added_to_hass(self) -> None:
        await super().async_added_to_hass()
        # Ripristino ultimo valore sensore
        last = await self.async_get_last_sensor_data()
        if last and last.native_value is not None:
            try:
                if isinstance(last.native_value, Decimal):
                    self._attr_native_value = float(last.native_value)
                else:
                    self._attr_native_value = float(last.native_value)  # str/float
                self._samples.append(self._attr_native_value)
            except (ValueError, TypeError):
                _LOGGER.debug("Restore skipped: invalid %r", last.native_value)

    @property
    def extra_state_attributes(self) -> dict[str, Any]:
        data: dict[str, Any] = {
            "coordinated_slave_id": self._idx,
            "area": self._area_config[CONF_AREA],
            "window_size": self._window_size,
            "samples_count": len(self._samples),
        }
        if self._climate_sensor == ClimateSensorType.DEW_POINT:
            perception = dew_point_perception(self._attr_native_value)
            data["human_perception"] = perception.unique_id if perception else "unknown"
        return data

    def _resolve_input_entities(self) -> None:
        """Determina gli entity_id di temperatura/umidità dalla config o dal fallback."""
        area_sensors = self._area_config.get("sensors") or self._area_config.get(CONF_SENSORS) or {}
        self._temperature_entity_id = area_sensors.get(CONF_TEMPERATURE)
        self._humidity_entity_id = area_sensors.get(CONF_HUMIDITY)

        # Fallback sul proprio entity_id (utile per current_x/min/max_conf)
        if not self._temperature_entity_id and self._climate_sensor in (
            ClimateSensorType.CURRENT_TEMPERATURE,
            ClimateSensorType.MAX_CONFORT_TEMPERATURE,
            ClimateSensorType.MIN_CONFORT_TEMPERATURE,
        ):
            self._temperature_entity_id = _slugify_name(self._attr_name)
        if not self._humidity_entity_id and self._climate_sensor in (
            ClimateSensorType.CURRENT_HUMIDITY,
            ClimateSensorType.MAX_CONFORT_HUMIDITY,
            ClimateSensorType.MIN_CONFORT_HUMIDITY,
        ):
            self._humidity_entity_id = _slugify_name(self._attr_name)

    @staticmethod
    def _coerce_value(v: Any, *, src: str) -> Optional[float]:
        """Normalizza un valore da State/str/float -> float o None."""
        if v is None:
            return None
        if isinstance(v, State):
            return convert_to_float(v.state, src, __name__)
        if isinstance(v, (int, float, Decimal, str)):
            try:
                return float(v)
            except (ValueError, TypeError):
                return None
        return None

    @callback
    def _handle_coordinator_update(self) -> None:
        """Handle updated data from the coordinator."""
        self._resolve_input_entities()
        data: Mapping[str, Any] = self.coordinator.data or {}

        t_id = self._temperature_entity_id
        h_id = self._humidity_entity_id

        t_raw = data.get(t_id) if t_id else None
        h_raw = data.get(h_id) if h_id else None

        t_val = self._coerce_value(t_raw, src="temp")
        h_val = self._coerce_value(h_raw, src="humi")

        # Sanity checks
        if h_val is not None and not (0.0 <= h_val <= 100.0):
            _LOGGER.debug("Humidity out of range (%.2f), ignoring", h_val)
            h_val = None

        new_value: Optional[float] = None
        available = False

        # --- Computazione
        if t_val is not None and h_val is not None:
            if self._climate_sensor == ClimateSensorType.DEW_POINT:
                new_value = round(dew_point(t_val, h_val), 1)
                available = True
            elif self._climate_sensor == ClimateSensorType.HEAT_INDEX:
                new_value = round(heat_index(t_val, h_val), 1)
                available = True
            elif self._climate_sensor == ClimateSensorType.CURRENT_TEMPERATURE:
                new_value = t_val
                available = True
            elif self._climate_sensor == ClimateSensorType.CURRENT_HUMIDITY:
                new_value = h_val
                available = True
        elif t_val is not None and self._climate_sensor in (
            ClimateSensorType.CURRENT_TEMPERATURE,
            ClimateSensorType.MAX_CONFORT_TEMPERATURE,
            ClimateSensorType.MIN_CONFORT_TEMPERATURE,
        ):
            new_value = t_val
            available = True
        elif h_val is not None and self._climate_sensor in (
            ClimateSensorType.CURRENT_HUMIDITY,
            ClimateSensorType.MAX_CONFORT_HUMIDITY,
            ClimateSensorType.MIN_CONFORT_HUMIDITY,
        ):
            new_value = h_val
            available = True

        self._attr_available = available

        if available and new_value is not None:
            # Rolling mean (senza pandas)
            self._samples.append(new_value)
            try:
                self._attr_native_value = round(fmean(self._samples), 1)
            except (ValueError, StatisticsError):  # deque vuota, etc.
                self._attr_native_value = round(new_value, 1)
        else:
            self._attr_native_value = None

        _LOGGER.debug(
            (
                "update area=%s type=%s T(%s)=%r -> %.2f, H(%s)=%r -> %.2f | "
                "available=%s value=%r (n=%d)"
            ),
            self._area_config.get(CONF_AREA),
            self._climate_sensor,
            t_id,
            t_raw,
            t_val if t_val is not None else float("nan"),
            h_id,
            h_raw,
            h_val if h_val is not None else float("nan"),
            self._attr_available,
            self._attr_native_value,
            len(self._samples),
        )

        super()._handle_coordinator_update()
